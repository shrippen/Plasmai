// Windows resources: the executable's icon (Explorer, taskbar, installer shortcuts)
// and its version information (configure_file fills in the version). The icon
// is contents/images/plasmai.svg at 16 to 256 px.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/windows/plasmai.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "shrippen"
            VALUE "FileDescription", "Plasmai"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "plasmai-app.exe"
            VALUE "ProductName", "Plasmai"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
